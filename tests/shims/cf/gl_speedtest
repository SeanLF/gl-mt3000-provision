#!/bin/sh
# Mimics the 4.11 binary: idle ping, samples, loaded ping, average, peak.
idle="${FAKE_IDLE%%/*}"; loaded="${FAKE_LOADED%%/*}"
phase() {
    [ -n "$2" ] || return 0
    peak=$(echo "$2" | awk '{ printf "%.2f", $1 * 1.05 }')
    sleep 0.4 # long enough for under_load's sampler (tests set SETUP_LINK_LOAD_DELAY=0.1)
    if [ "${FAKE_IDLE_BROKEN:-}" = "$1" ] || [ "${FAKE_IDLE_BROKEN:-}" = "both" ]; then
        echo "[00:00:00.000] idle ping avg ms"
    else
        echo "[00:00:00.000] idle ping avg ${idle:-20.0} ms"
    fi
    echo "[00:00:00.000] phase connecting ifname=eth0"
    echo "[00:00:01.000] $1 sample $2 Mbps"
    echo "[00:00:10.000] loaded ping avg ${loaded:-21.0} ms"
    echo "[00:00:10.000] $1 ping summary idle=${idle:-20.0}ms loaded=${loaded:-21.0}ms"
    echo "[00:00:10.000] $1 average $2 Mbps"
    echo "[00:00:10.000] $1 $peak Mbps"
}
[ "${FAKE_CF_DEAD:-}" = 1 ] && exit 1
case "$1" in
    ping) echo "[00:00:00.000] idle ping avg ${idle:-20.0} ms" ;;
    download) phase download "${FAKE_DL:-}" ;;
    upload) phase upload "${FAKE_UL:-}" ;;
esac
